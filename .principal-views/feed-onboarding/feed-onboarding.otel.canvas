    {
      "id": "onboarding-skipped",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 800,
      "width": 200,
      "height": 100,
      "color": "#f59e0b",
      "label": "Onboarding Skipped",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#fbbf24",
        "stroke": "#f59e0b"
      },
      "event": {
        "name": "feed-onboarding.skipped",
        "attributes": {
          "skippedAtStep": {
            "type": "integer",
            "description": "Which step was skipped at (1 or 2)",
            "required": true
          }
        }
      }
