      "id": "follow-repo-error",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": -200,
      "y": 500,
      "width": 200,
      "height": 100,
      "color": "#dc2626",
      "label": "Follow Repo Error",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx",
          "src/services/FeedApiService.ts"
        ],
        "shape": "rectangle",
        "fill": "#ef4444",
        "stroke": "#dc2626"
      },
      "event": {
        "name": "feed-onboarding.follow-repo.error",
        "attributes": {
          "repoFullName": {
            "type": "string",
