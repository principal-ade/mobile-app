  ],
  "edges": [
    {
      "id": "check-to-start",
      "fromNode": "onboarding-check",
      "fromSide": "bottom",
      "toNode": "onboarding-started",
      "toSide": "top",
      "label": "needs onboarding",
      "edgeType": "conditional"
    },
    {
      "id": "start-to-step1",
      "fromNode": "onboarding-started",
      "fromSide": "bottom",
      "toNode": "step1-users",
      "toSide": "top",
      "edgeType": "flow"
    },
    {
      "id": "step1-search",
      "fromNode": "step1-users",
      "fromSide": "right",
      "toNode": "user-search",
      "toSide": "left",
      "edgeType": "user-action"
    },
    {
      "id": "step1-select",
      "fromNode": "step1-users",
      "fromSide": "right",
      "toNode": "user-selected",
      "toSide": "left",
      "edgeType": "user-action"
    },
    {
      "id": "search-to-select",
      "fromNode": "user-search",
      "fromSide": "bottom",
      "toNode": "user-selected",
      "toSide": "top",
      "edgeType": "user-action"
    },
    {
      "id": "step1-to-complete",
      "fromNode": "step1-users",
      "fromSide": "bottom",
      "toNode": "step1-complete",
      "toSide": "top",
      "label": "next/skip",
      "edgeType": "flow"
    },
    {
      "id": "step1-to-step2",
      "fromNode": "step1-complete",
      "fromSide": "bottom",
      "toNode": "step2-repos",
      "toSide": "top",
      "edgeType": "flow"
    },
    {
      "id": "step2-search",
      "fromNode": "step2-repos",
      "fromSide": "right",
      "toNode": "repo-search",
      "toSide": "left",
      "edgeType": "user-action"
    },
    {
      "id": "step2-select",
      "fromNode": "step2-repos",
      "fromSide": "right",
      "toNode": "repo-selected",
      "toSide": "left",
      "edgeType": "user-action"
    },
    {
      "id": "repo-search-to-select",
      "fromNode": "repo-search",
      "fromSide": "bottom",
      "toNode": "repo-selected",
      "toSide": "top",
      "edgeType": "user-action"
    },
    {
      "id": "step2-to-complete",
      "fromNode": "step2-repos",
      "fromSide": "bottom",
      "toNode": "onboarding-complete",
      "toSide": "top",
      "label": "done/skip",
      "edgeType": "flow"
    },
    {
      "id": "complete-to-follow-user",
      "fromNode": "onboarding-complete",
      "fromSide": "left",
      "toNode": "follow-user-success",
      "toSide": "right",
      "label": "per user",
      "edgeType": "data-flow"
    },
    {
      "id": "follow-user-error-edge",
      "fromNode": "follow-user-success",
      "fromSide": "top",
      "toNode": "follow-user-error",
      "toSide": "bottom",
      "edgeType": "error"
    },
    {
      "id": "complete-to-follow-repo",
      "fromNode": "onboarding-complete",
      "fromSide": "left",
      "toNode": "follow-repo-success",
      "toSide": "right",
      "label": "per repo",
      "edgeType": "data-flow"
    },
    {
      "id": "follow-repo-error-edge",
      "fromNode": "follow-repo-success",
      "fromSide": "top",
      "toNode": "follow-repo-error",
      "toSide": "bottom",
      "edgeType": "error"
    },
    {
      "id": "step2-to-skipped",
      "fromNode": "step2-repos",
      "fromSide": "right",
      "toNode": "onboarding-skipped",
      "toSide": "left",
      "label": "skip all",
      "edgeType": "user-action"
    }
  ]
}
