{
  "name": "Feed Onboarding",
  "markdown": ".principal-views/feed-onboarding/feed-onboarding.md",
  "edgeTypes": {
    "flow": {
      "label": "Flow"
    },
    "error": {
      "label": "Error Path"
    },
    "user-action": {
      "label": "User Action"
    },
    "data-flow": {
      "label": "Data Flow"
    },
    "conditional": {
      "label": "Conditional"
    }
  },
  "nodes": [
    {
      "id": "onboarding-check",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#4b5563",
      "label": "Check Onboarding Needed",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedTabScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#6b7280",
        "stroke": "#4b5563"
      },
      "event": {
        "name": "feed-onboarding.check",
        "attributes": {
          "isAuthenticated": {
            "type": "boolean",
            "description": "Whether user is authenticated",
            "required": true
          },
          "followedUsersCount": {
            "type": "integer",
            "description": "Number of users already followed",
            "required": true
          },
          "followedReposCount": {
            "type": "integer",
            "description": "Number of repos already followed",
            "required": true
          },
          "needsOnboarding": {
            "type": "boolean",
            "description": "Whether onboarding is needed",
            "required": true
          }
        }
      }
    },
    {
      "id": "onboarding-started",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 200,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Onboarding Started",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "feed-onboarding.started",
        "attributes": {
          "suggestedUsersCount": {
            "type": "integer",
            "description": "Number of suggested users loaded",
            "required": true
          }
        }
      }
    },
    {
      "id": "step1-users",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 350,
      "width": 200,
      "height": 100,
      "color": "#1d4ed8",
      "label": "Step 1: Select Users",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#3b82f6",
        "stroke": "#1d4ed8"
      },
      "event": {
        "name": "feed-onboarding.step1.view",
        "attributes": {
          "suggestedUsersCount": {
            "type": "integer",
            "description": "Number of suggested users shown",
            "required": true
          }
        }
      }
    },
    {
      "id": "user-selected",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 350,
      "width": 200,
      "height": 100,
      "color": "#0891b2",
      "label": "User Selected",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#06b6d4",
        "stroke": "#0891b2"
      },
      "event": {
        "name": "feed-onboarding.user.selected",
        "attributes": {
          "login": {
            "type": "string",
            "description": "GitHub username selected",
            "required": true
          },
          "source": {
            "type": "string",
            "description": "Where user came from: 'suggestion', 'search'",
            "required": true
          },
          "totalSelected": {
            "type": "integer",
            "description": "Total users selected so far",
            "required": true
          }
        }
      }
    },
    {
      "id": "user-search",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 200,
      "width": 200,
      "height": 100,
      "color": "#6d28d9",
      "label": "User Search",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#8b5cf6",
        "stroke": "#6d28d9"
      },
      "event": {
        "name": "feed-onboarding.user.search",
        "attributes": {
          "query": {
            "type": "string",
            "description": "Search query entered",
            "required": true
          },
          "resultsCount": {
            "type": "integer",
            "description": "Number of results returned",
            "required": true
          }
        }
      }
    },
    {
      "id": "step1-complete",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 500,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Step 1 Complete",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "feed-onboarding.step1.complete",
        "attributes": {
          "selectedUsersCount": {
            "type": "integer",
            "description": "Number of users selected",
            "required": true
          },
          "wasSkipped": {
            "type": "boolean",
            "description": "Whether step was skipped",
            "required": true
          }
        }
      }
    },
    {
      "id": "step2-repos",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 650,
      "width": 200,
      "height": 100,
      "color": "#1d4ed8",
      "label": "Step 2: Select Repos",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#3b82f6",
        "stroke": "#1d4ed8"
      },
      "event": {
        "name": "feed-onboarding.step2.view",
        "attributes": {
          "suggestedReposCount": {
            "type": "integer",
            "description": "Number of suggested repos shown",
            "required": true
          },
          "featuredReposCount": {
            "type": "integer",
            "description": "Number of featured repos shown",
            "required": true
          }
        }
      }
    },
    {
      "id": "repo-selected",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 650,
      "width": 200,
      "height": 100,
      "color": "#0891b2",
      "label": "Repo Selected",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#06b6d4",
        "stroke": "#0891b2"
      },
      "event": {
        "name": "feed-onboarding.repo.selected",
        "attributes": {
          "repoFullName": {
            "type": "string",
            "description": "Repository full name (owner/repo)",
            "required": true
          },
          "source": {
            "type": "string",
            "description": "Where repo came from: 'featured', 'suggested', 'search'",
            "required": true
          },
          "totalSelected": {
            "type": "integer",
            "description": "Total repos selected so far",
            "required": true
          }
        }
      }
    },
    {
      "id": "repo-search",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 500,
      "width": 200,
      "height": 100,
      "color": "#6d28d9",
      "label": "Repo Search",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#8b5cf6",
        "stroke": "#6d28d9"
      },
      "event": {
        "name": "feed-onboarding.repo.search",
        "attributes": {
          "query": {
            "type": "string",
            "description": "Search query entered",
            "required": true
          },
          "resultsCount": {
            "type": "integer",
            "description": "Number of results returned",
            "required": true
          }
        }
      }
    },
    {
      "id": "onboarding-complete",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 800,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Onboarding Complete",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "feed-onboarding.complete",
        "attributes": {
          "totalUsersFollowed": {
            "type": "integer",
            "description": "Number of users followed",
            "required": true
          },
          "totalReposFollowed": {
            "type": "integer",
            "description": "Number of repos followed",
            "required": true
          },
          "wasFullySkipped": {
            "type": "boolean",
            "description": "Whether both steps were skipped",
            "required": true
          }
        }
      }
    },
    {
      "id": "follow-user-success",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": -200,
      "y": 800,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Follow User Success",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx",
          "src/services/FeedApiService.ts"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "feed-onboarding.follow-user.success",
        "attributes": {
          "login": {
            "type": "string",
            "description": "GitHub username followed",
            "required": true
          }
        }
      }
    },
    {
      "id": "follow-user-error",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": -200,
      "y": 650,
      "width": 200,
      "height": 100,
      "color": "#dc2626",
      "label": "Follow User Error",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx",
          "src/services/FeedApiService.ts"
        ],
        "shape": "rectangle",
        "fill": "#ef4444",
        "stroke": "#dc2626"
      },
      "event": {
        "name": "feed-onboarding.follow-user.error",
        "attributes": {
          "login": {
            "type": "string",
            "description": "GitHub username that failed",
            "required": true
          },
          "error.message": {
            "type": "string",
            "description": "Error message",
            "required": true
          }
        }
      }
    },
    {
      "id": "follow-repo-success",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": -200,
      "y": 950,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Follow Repo Success",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/FeedOnboardingScreen.tsx",
          "src/services/FeedApiService.ts"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "feed-onboarding.follow-repo.success",
        "attributes": {
          "repoFullName": {
            "type": "string",
            "description": "Repository full name followed",
            "required": true
          }
        }
      }
    },
