{
  "nodes": [
    {
      "id": "app-root",
      "type": "text",
      "text": "# App\n\nRoot component\nThemeProvider + AuthProvider",
      "x": 300,
      "y": 0,
      "width": 200,
      "height": 120,
      "color": "#22c55e",
      "pv": {
        "nodeType": "component",
        "icon": "Smartphone",
        "shape": "rectangle"
      }
    },
    {
      "id": "auth-check",
      "type": "text",
      "text": "# Auth Check\n\nisAuthenticated?",
      "x": 300,
      "y": 170,
      "width": 200,
      "height": 100,
      "color": "#eab308",
      "pv": {
        "nodeType": "decision",
        "icon": "Shield",
        "shape": "diamond"
      }
    },
    {
      "id": "login-screen",
      "type": "text",
      "text": "# LoginScreen\n\nGitHub OAuth login\nPKCE flow",
      "x": 50,
      "y": 320,
      "width": 200,
      "height": 120,
      "color": "#8b5cf6",
      "pv": {
        "nodeType": "screen",
        "icon": "LogIn",
        "shape": "rectangle",
        "references": ["src/screens/LoginScreen.tsx"]
      }
    },
    {
      "id": "repo-list-screen",
      "type": "text",
      "text": "# RepositoryListScreen\n\nBrowse user repos\nMarkdown file browser",
      "x": 550,
      "y": 320,
      "width": 200,
      "height": 120,
      "color": "#06b6d4",
      "pv": {
        "nodeType": "screen",
        "icon": "FolderGit2",
        "shape": "rectangle",
        "references": ["src/screens/RepositoryListScreen.tsx"]
      }
    },
    {
      "id": "document-screen",
      "type": "text",
      "text": "# DocumentScreen\n\nView file content\n(raw text currently)",
      "x": 550,
      "y": 490,
      "width": 200,
      "height": 120,
      "color": "#06b6d4",
      "pv": {
        "nodeType": "screen",
        "icon": "FileText",
        "shape": "rectangle",
        "references": ["src/screens/DocumentScreen.tsx"]
      }
    },
    {
      "id": "github-api",
      "type": "text",
      "text": "# GitHub API\n\nRepos, contents,\nfile fetching",
      "x": 850,
      "y": 400,
      "width": 200,
      "height": 120,
      "color": "#4b5563",
      "pv": {
        "nodeType": "external",
        "icon": "Cloud",
        "shape": "rectangle"
      }
    },
    {
      "id": "secure-store",
      "type": "text",
      "text": "# SecureStore\n\nToken + user storage\nexpo-secure-store",
      "x": 50,
      "y": 490,
      "width": 200,
      "height": 120,
      "color": "#4b5563",
      "pv": {
        "nodeType": "storage",
        "icon": "Lock",
        "shape": "rectangle"
      }
    },
    {
      "id": "future-activity-feed",
      "type": "text",
      "text": "# ActivityFeedScreen\n\n(Planned)\nNew home screen",
      "x": 300,
      "y": 650,
      "width": 200,
      "height": 120,
      "color": "#f97316",
      "pv": {
        "nodeType": "screen",
        "icon": "Activity",
        "shape": "rectangle",
        "status": "planned"
      }
    }
  ],
  "edges": [
    {
      "id": "app-to-auth",
      "fromNode": "app-root",
      "toNode": "auth-check",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "auth-to-login",
      "fromNode": "auth-check",
      "toNode": "login-screen",
      "fromSide": "left",
      "toSide": "top",
      "label": "not authenticated",
      "pv": {
        "edgeType": "conditional"
      }
    },
    {
      "id": "auth-to-repos",
      "fromNode": "auth-check",
      "toNode": "repo-list-screen",
      "fromSide": "right",
      "toSide": "top",
      "label": "authenticated",
      "pv": {
        "edgeType": "conditional"
      }
    },
    {
      "id": "login-to-store",
      "fromNode": "login-screen",
      "toNode": "secure-store",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "save token",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "repos-to-document",
      "fromNode": "repo-list-screen",
      "toNode": "document-screen",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "select file",
      "pv": {
        "edgeType": "navigation"
      }
    },
    {
      "id": "repos-to-api",
      "fromNode": "repo-list-screen",
      "toNode": "github-api",
      "fromSide": "right",
      "toSide": "left",
      "label": "fetch repos/contents",
      "pv": {
        "edgeType": "api-call"
      }
    },
    {
      "id": "document-to-api",
      "fromNode": "document-screen",
      "toNode": "github-api",
      "fromSide": "right",
      "toSide": "left",
      "label": "fetch file",
      "pv": {
        "edgeType": "api-call"
      }
    },
    {
      "id": "login-success",
      "fromNode": "login-screen",
      "toNode": "repo-list-screen",
      "fromSide": "right",
      "toSide": "left",
      "label": "OAuth success",
      "color": "#22c55e",
      "pv": {
        "edgeType": "navigation",
        "style": "dashed"
      }
    },
    {
      "id": "future-replaces",
      "fromNode": "future-activity-feed",
      "toNode": "repo-list-screen",
      "fromSide": "top",
      "toSide": "bottom",
      "label": "will replace",
      "color": "#f97316",
      "pv": {
        "edgeType": "planned",
        "style": "dotted"
      }
    }
  ],
  "pv": {
    "version": "1.0",
    "name": "App Navigation",
    "description": "Current screen structure and navigation flow",
    "markdown": ".principal-views/app-navigation.md",
    "display": {
      "layout": "manual"
    },
    "nodeTypes": {
      "component": {
        "label": "Component",
        "shape": "rectangle"
      },
      "decision": {
        "label": "Decision",
        "shape": "diamond"
      },
      "screen": {
        "label": "Screen",
        "shape": "rectangle"
      },
      "external": {
        "label": "External Service",
        "shape": "rectangle"
      },
      "storage": {
        "label": "Storage",
        "shape": "rectangle"
      }
    },
    "edgeTypes": {
      "flow": {
        "label": "Flow"
      },
      "conditional": {
        "label": "Conditional"
      },
      "data-flow": {
        "label": "Data Flow"
      },
      "navigation": {
        "label": "Navigation"
      },
      "api-call": {
        "label": "API Call"
      },
      "planned": {
        "label": "Planned"
      }
    }
  }
}
