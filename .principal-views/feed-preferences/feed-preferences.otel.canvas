          "newVersion": {
            "type": "integer",
            "description": "New version number",
            "required": true
          },
          "trigger": {
            "type": "string",
            "description": "What caused the version change: 'add-user', 'remove-user', 'add-repo', 'remove-repo', 'reset'",
            "required": true
          }
        }
      }
