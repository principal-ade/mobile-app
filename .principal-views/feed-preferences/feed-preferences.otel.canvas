{
  "name": "Feed Preferences Context",
  "markdown": ".principal-views/feed-preferences/feed-preferences.md",
  "edgeTypes": {
    "flow": {
      "label": "Flow"
    },
    "error": {
      "label": "Error Path"
    },
    "user-action": {
      "label": "User Action"
    },
    "data-flow": {
      "label": "Data Flow"
    },
    "conditional": {
      "label": "Conditional"
    },
    "triggers": {
      "label": "Triggers"
    }
  },
  "nodes": [
    {
      "id": "context-bootstrap-started",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Bootstrap Started",
      "pv": {
        "status": "draft",
        "references": [
          "src/context/FeedPreferencesContext.tsx"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "feed-preferences.bootstrap.started",
        "attributes": {}
      }
    },
    {
      "id": "context-bootstrap-load-storage",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 200,
      "width": 200,
      "height": 100,
      "color": "#6d28d9",
      "label": "Load From Storage",
      "pv": {
        "status": "draft",
        "references": [
          "src/context/FeedPreferencesContext.tsx",
          "src/utils/feedStorage.ts"
        ],
        "shape": "rectangle",
        "fill": "#8b5cf6",
        "stroke": "#6d28d9"
      },
      "event": {
        "name": "feed-preferences.bootstrap.load-storage",
        "attributes": {
          "storageType": {
            "type": "string",
            "description": "Storage used: 'secure-store' or 'local-storage'",
            "required": true
          }
        }
      }
    },
    {
      "id": "context-bootstrap-success",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 350,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Bootstrap Success",
      "pv": {
        "status": "draft",
        "references": [
          "src/context/FeedPreferencesContext.tsx"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "feed-preferences.bootstrap.success",
        "attributes": {
          "followedUsersCount": {
            "type": "integer",
            "description": "Number of users loaded from storage",
            "required": true
          },
          "followedReposCount": {
            "type": "integer",
            "description": "Number of repos loaded from storage",
            "required": true
          },
          "usedDefaults": {
            "type": "boolean",
            "description": "Whether default repos were used",
            "required": true
          }
        }
      }
    },
    {
      "id": "context-bootstrap-error",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 200,
      "width": 200,
      "height": 100,
      "color": "#dc2626",
      "label": "Bootstrap Error",
      "pv": {
        "status": "draft",
        "references": [
          "src/context/FeedPreferencesContext.tsx"
        ],
        "shape": "rectangle",
        "fill": "#ef4444",
        "stroke": "#dc2626"
      },
      "event": {
        "name": "feed-preferences.bootstrap.error",
        "attributes": {
          "error.message": {
            "type": "string",
            "description": "Error message",
            "required": true
          }
        }
      }
    },
    {
      "id": "add-user",
