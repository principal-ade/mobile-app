  "edges": [
    {
      "id": "bootstrap-1",
      "fromNode": "context-bootstrap-started",
      "fromSide": "bottom",
      "toNode": "context-bootstrap-load-storage",
      "toSide": "top",
      "edgeType": "flow"
    },
    {
      "id": "bootstrap-2",
      "fromNode": "context-bootstrap-load-storage",
      "fromSide": "bottom",
      "toNode": "context-bootstrap-success",
      "toSide": "top",
      "edgeType": "flow"
    },
    {
      "id": "bootstrap-3",
      "fromNode": "context-bootstrap-load-storage",
      "fromSide": "right",
      "toNode": "context-bootstrap-error",
      "toSide": "left",
      "edgeType": "error"
    },
    {
      "id": "bootstrap-4",
      "fromNode": "context-bootstrap-error",
      "fromSide": "bottom",
      "toNode": "context-bootstrap-success",
      "toSide": "right",
      "label": "use defaults",
      "edgeType": "conditional"
    },
    {
