{
  "pv": {
    "name": "Mobile Activity Feed",
    "version": "1.0.0",
    "markdown": ".principal-views/activity-feed/activity-feed.md",
    "edgeTypes": {
      "flow": {
        "label": "Flow"
      },
      "error": {
        "label": "Error Path"
      },
      "user-action": {
        "label": "User Action"
      },
      "data-flow": {
        "label": "Data Flow"
      },
      "conditional": {
        "label": "Conditional"
      }
    }
  },
  "nodes": [
    {
      "id": "feed-init-started",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Feed Init Started",
      "pv": {
        "status": "draft",
        "references": [
          "src/hooks/useActivityFeed.ts",
          "src/screens/ActivityFeedScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "activity-feed.init.started",
        "attributes": {
          "repoCount": {
            "type": "integer",
            "description": "Number of featured repos to fetch",
            "required": true
          },
          "commitsPerRepo": {
            "type": "integer",
            "description": "Max commits to fetch per repo (default: 10)",
            "required": true
          }
        }
      }
    },
    {
      "id": "feed-fetch-batch",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 200,
      "width": 200,
      "height": 100,
      "color": "#6d28d9",
      "label": "Batch Fetch Repos",
      "pv": {
        "status": "draft",
        "references": [
          "src/hooks/useActivityFeed.ts"
        ],
        "shape": "rectangle",
        "fill": "#8b5cf6",
        "stroke": "#6d28d9"
      },
      "event": {
        "name": "activity-feed.fetch.batch.started",
        "attributes": {
          "repoCount": {
            "type": "integer",
            "description": "Number of repos being fetched in parallel",
            "required": true
          }
        }
      }
    },
    {
      "id": "feed-fetch-repo-item",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 350,
      "width": 200,
      "height": 100,
      "color": "#0891b2",
      "label": "Repo Commits Loaded",
      "pv": {
        "status": "draft",
        "references": [
          "src/hooks/useActivityFeed.ts"
        ],
        "shape": "rectangle",
        "fill": "#06b6d4",
        "stroke": "#0891b2"
      },
      "event": {
        "name": "activity-feed.fetch.repo.loaded",
        "attributes": {
          "repoFullName": {
            "type": "string",
            "description": "Repository full name (owner/repo)",
            "required": true
          },
          "commitCount": {
            "type": "integer",
            "description": "Number of commits in last 24 hours",
            "required": true
          }
        }
      }
    },
    {
      "id": "feed-fetch-repo-error",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 350,
      "width": 200,
      "height": 100,
      "color": "#dc2626",
      "label": "Repo Fetch Error",
      "pv": {
        "status": "draft",
        "references": [
          "src/hooks/useActivityFeed.ts"
        ],
        "shape": "rectangle",
        "fill": "#ef4444",
        "stroke": "#dc2626"
      },
      "event": {
        "name": "activity-feed.fetch.repo.error",
        "attributes": {
          "repoFullName": {
            "type": "string",
            "description": "Repository that failed to load",
            "required": true
          },
          "error.message": {
            "type": "string",
            "description": "Error message",
            "required": true
          },
          "httpStatus": {
            "type": "integer",
            "description": "HTTP status code if available",
            "required": false
          }
        }
      }
    },
    {
      "id": "feed-init-success",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 500,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Feed Ready",
      "pv": {
        "status": "draft",
        "references": [
          "src/hooks/useActivityFeed.ts",
          "src/screens/ActivityFeedScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "activity-feed.init.success",
        "attributes": {
          "repoCount": {
            "type": "integer",
            "description": "Number of repos with activity",
            "required": true
          },
          "totalCommits": {
            "type": "integer",
            "description": "Total commits across all repos",
            "required": true
          }
        }
      }
    },
    {
      "id": "feed-init-empty",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 500,
      "width": 200,
      "height": 100,
      "color": "#4b5563",
      "label": "Feed Empty",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/ActivityFeedScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#6b7280",
        "stroke": "#4b5563"
      },
      "event": {
        "name": "activity-feed.init.empty",
        "attributes": {
          "reason": {
            "type": "string",
            "description": "Why feed is empty: 'no-repos', 'no-recent-commits'",
            "required": true
          }
        }
      }
    },
    {
      "id": "feed-init-error",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 200,
      "width": 200,
      "height": 100,
      "color": "#dc2626",
      "label": "Init Error",
      "pv": {
        "status": "draft",
        "references": [
          "src/hooks/useActivityFeed.ts"
        ],
        "shape": "rectangle",
        "fill": "#ef4444",
        "stroke": "#dc2626"
      },
      "event": {
        "name": "activity-feed.init.error",
        "attributes": {
          "error.message": {
            "type": "string",
            "description": "Error message",
            "required": true
          }
        }
      }
    },
    {
      "id": "feed-refresh-started",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": -200,
      "y": 200,
      "width": 200,
      "height": 100,
      "color": "#1d4ed8",
      "label": "Refresh Started",
      "pv": {
        "status": "draft",
        "references": [
          "src/hooks/useActivityFeed.ts",
          "src/screens/ActivityFeedScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#3b82f6",
        "stroke": "#1d4ed8"
      },
      "event": {
        "name": "activity-feed.refresh.started",
        "attributes": {
          "trigger": {
            "type": "string",
            "description": "What triggered refresh: 'pull-to-refresh', 'app-foreground', 'manual'",
            "required": true
          }
        }
      }
    },
    {
      "id": "feed-refresh-complete",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": -200,
      "y": 350,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "Refresh Complete",
      "pv": {
        "status": "draft",
        "references": [
          "src/hooks/useActivityFeed.ts"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "activity-feed.refresh.complete",
        "attributes": {
          "updatedCount": {
            "type": "integer",
            "description": "Number of repos that had new data",
            "required": true
          },
          "newCommitCount": {
            "type": "integer",
            "description": "Number of new commits since last refresh",
            "required": true
          }
        }
      }
    },
    {
      "id": "feed-app-state-change",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": -200,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#4b5563",
      "label": "App State Change",
      "pv": {
        "status": "draft",
        "references": [
          "src/screens/ActivityFeedScreen.tsx"
        ],
        "shape": "rectangle",
        "fill": "#6b7280",
        "stroke": "#4b5563"
      },
      "event": {
        "name": "activity-feed.app-state.change",
        "attributes": {
          "state": {
            "type": "string",
            "description": "App state: 'active', 'background', 'inactive'",
            "required": true
          },
          "action": {
            "type": "string",
            "description": "Action taken: 'refresh', 'pause-polling', 'resume-polling'",
            "required": true
          }
        }
      }
    },
    {
      "id": "card-swipe",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 700,
      "width": 200,
      "height": 100,
      "color": "#0891b2",
      "label": "Card Swipe",
      "pv": {
        "status": "draft",
        "references": [
          "src/components/ActivityFeed/RepoCardCarousel.tsx"
        ],
        "shape": "rectangle",
        "fill": "#06b6d4",
        "stroke": "#0891b2"
      },
      "event": {
        "name": "activity-feed.card.swipe",
        "attributes": {
          "fromIndex": {
            "type": "integer",
            "description": "Previous card index",
            "required": true
          },
          "toIndex": {
            "type": "integer",
            "description": "New card index",
            "required": true
          },
          "repoFullName": {
            "type": "string",
            "description": "Repository now visible",
            "required": true
          },
          "direction": {
            "type": "string",
            "description": "Swipe direction: 'up', 'down'",
            "required": true
          }
        }
      }
    },
    {
      "id": "commit-swipe",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 850,
      "width": 200,
      "height": 100,
      "color": "#0891b2",
      "label": "Commit Swipe",
      "pv": {
        "status": "draft",
        "references": [
          "src/components/ActivityFeed/CommitCarousel.tsx"
        ],
        "shape": "rectangle",
        "fill": "#06b6d4",
        "stroke": "#0891b2"
      },
      "event": {
        "name": "activity-feed.commit.swipe",
        "attributes": {
          "repoFullName": {
            "type": "string",
            "description": "Repository being viewed",
            "required": true
          },
          "fromCommitIndex": {
            "type": "integer",
            "description": "Previous commit index",
            "required": true
          },
          "toCommitIndex": {
            "type": "integer",
            "description": "New commit index",
            "required": true
          },
          "commitSha": {
            "type": "string",
            "description": "Commit SHA now visible",
            "required": true
          },
          "direction": {
            "type": "string",
            "description": "Swipe direction: 'left', 'right'",
            "required": true
          }
        }
      }
    },
    {
      "id": "filecity-load",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 100,
      "y": 1000,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "label": "File City Loaded",
      "pv": {
        "status": "draft",
        "references": [
          "src/components/ActivityFeed/FileCityImage.tsx"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "event": {
        "name": "activity-feed.filecity.loaded",
        "attributes": {
          "repoFullName": {
            "type": "string",
            "description": "Repository being visualized",
            "required": true
          },
          "commitSha": {
            "type": "string",
            "description": "Commit SHA highlighting changes",
            "required": false
          },
          "wasPrefetched": {
            "type": "boolean",
            "description": "Whether image was prefetched",
            "required": true
          },
          "loadTimeMs": {
            "type": "integer",
            "description": "Time to load image in milliseconds",
            "required": true
          }
        }
      }
    },
    {
      "id": "filecity-error",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 1000,
      "width": 200,
      "height": 100,
      "color": "#dc2626",
      "label": "File City Error",
      "pv": {
        "status": "draft",
        "references": [
          "src/components/ActivityFeed/FileCityImage.tsx"
        ],
        "shape": "rectangle",
        "fill": "#ef4444",
        "stroke": "#dc2626"
      },
      "event": {
        "name": "activity-feed.filecity.error",
        "attributes": {
          "repoFullName": {
            "type": "string",
            "description": "Repository that failed",
            "required": true
          },
          "commitSha": {
            "type": "string",
            "description": "Commit SHA if applicable",
            "required": false
          },
          "error.message": {
            "type": "string",
            "description": "Error description",
            "required": true
          }
        }
      }
    },
    {
      "id": "commit-tap",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 850,
      "width": 200,
      "height": 100,
      "color": "#6d28d9",
      "label": "Commit Tap",
      "pv": {
        "status": "draft",
        "references": [
          "src/components/ActivityFeed/CommitCard.tsx"
        ],
        "shape": "rectangle",
        "fill": "#8b5cf6",
        "stroke": "#6d28d9"
      },
      "event": {
        "name": "activity-feed.commit.tap",
        "attributes": {
          "repoFullName": {
            "type": "string",
            "description": "Repository being viewed",
            "required": true
          },
          "commitSha": {
            "type": "string",
            "description": "Commit SHA tapped",
            "required": true
          },
          "action": {
            "type": "string",
            "description": "Action taken: 'open-github', 'view-details', 'copy-sha'",
            "required": true
          }
        }
      }
    },
    {
      "id": "author-tap",
      "type": "otel-event",
      "otel": {
        "status": "draft"
      },
      "x": 400,
      "y": 700,
      "width": 200,
      "height": 100,
      "color": "#0891b2",
      "label": "Author Tap",
      "pv": {
        "status": "draft",
        "references": [
          "src/components/ActivityFeed/AuthorAvatar.tsx"
        ],
        "shape": "rectangle",
        "fill": "#06b6d4",
        "stroke": "#0891b2"
      },
      "event": {
        "name": "activity-feed.author.tap",
        "attributes": {
          "username": {
            "type": "string",
            "description": "GitHub username tapped",
            "required": true
          },
          "action": {
            "type": "string",
            "description": "Action taken: 'open-profile', 'view-commits'",
            "required": true
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "init-1",
      "fromNode": "feed-init-started",
      "fromSide": "bottom",
      "toNode": "feed-fetch-batch",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "init-2",
      "fromNode": "feed-fetch-batch",
      "fromSide": "bottom",
      "toNode": "feed-fetch-repo-item",
      "toSide": "top",
      "label": "per repo",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "init-3",
      "fromNode": "feed-fetch-batch",
      "fromSide": "right",
      "toNode": "feed-fetch-repo-error",
      "toSide": "left",
      "pv": {
        "edgeType": "error"
      }
    },
    {
      "id": "init-4",
      "fromNode": "feed-fetch-batch",
      "fromSide": "right",
      "toNode": "feed-init-error",
      "toSide": "left",
      "pv": {
        "edgeType": "error"
      }
    },
    {
      "id": "init-5",
      "fromNode": "feed-fetch-repo-item",
      "fromSide": "bottom",
      "toNode": "feed-init-success",
      "toSide": "top",
      "label": "all loaded",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "init-6",
      "fromNode": "feed-fetch-repo-item",
      "fromSide": "right",
      "toNode": "feed-init-empty",
      "toSide": "left",
      "label": "no commits",
      "pv": {
        "edgeType": "conditional"
      }
    },
    {
      "id": "refresh-1",
      "fromNode": "feed-app-state-change",
      "fromSide": "bottom",
      "toNode": "feed-refresh-started",
      "toSide": "top",
      "label": "active",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "refresh-2",
      "fromNode": "feed-refresh-started",
      "fromSide": "bottom",
      "toNode": "feed-refresh-complete",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "refresh-3",
      "fromNode": "feed-refresh-started",
      "fromSide": "right",
      "toNode": "feed-fetch-batch",
      "toSide": "left",
      "label": "triggers",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "ui-1",
      "fromNode": "feed-init-success",
      "fromSide": "bottom",
      "toNode": "card-swipe",
      "toSide": "top",
      "label": "user interaction",
      "pv": {
        "edgeType": "user-action"
      }
    },
    {
      "id": "ui-2",
      "fromNode": "card-swipe",
      "fromSide": "bottom",
      "toNode": "commit-swipe",
      "toSide": "top",
      "pv": {
        "edgeType": "user-action"
      }
    },
    {
      "id": "ui-3",
      "fromNode": "commit-swipe",
      "fromSide": "bottom",
      "toNode": "filecity-load",
      "toSide": "top",
      "label": "triggers",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "ui-4",
      "fromNode": "filecity-load",
      "fromSide": "right",
      "toNode": "filecity-error",
      "toSide": "left",
      "pv": {
        "edgeType": "error"
      }
    },
    {
      "id": "ui-5",
      "fromNode": "card-swipe",
      "fromSide": "right",
      "toNode": "author-tap",
      "toSide": "left",
      "pv": {
        "edgeType": "user-action"
      }
    },
    {
      "id": "ui-6",
      "fromNode": "commit-swipe",
      "fromSide": "right",
      "toNode": "commit-tap",
      "toSide": "left",
      "pv": {
        "edgeType": "user-action"
      }
    }
  ]
}
