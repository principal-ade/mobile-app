{
  "expo": {
    "name": "PrincipalADE",
    "slug": "principal-ade-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noetic-labs.principal-ai-mobile",
      "infoPlist": {
        "CFBundleDisplayName": "Principal ADE",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
"predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "githubmarkdownreader",
    "extra": {
      "githubClientId": "Ov23libhQoLcZYmvIovc",
      "githubScopes": ["repo"],
      "eas": {
        "projectId": "f1206516-031c-4186-87a2-a4cbdbdb1e9a"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
