{
  "expo": {
    "name": "PrincipalAI",
    "slug": "principal-ade-mobile",
    "version": "1.17.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d274d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noetic-labs.principal-ai-mobile",
      "buildNumber": "23",
      "infoPlist": {
        "CFBundleDisplayName": "Principal AI",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d274d"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "principal-ai",
    "extra": {
      "authServerUrl": "https://auth.principal-ade.com",
      "eas": {
        "projectId": "f1206516-031c-4186-87a2-a4cbdbdb1e9a"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ],
    "owner": "principal-ade"
  }
}
